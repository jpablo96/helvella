# Los archivos de /assets llevan un hash en el nombre, asi que se pueden cachear para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fotos y videos: no llevan hash, asi que se cachean una semana. Si reemplazas un archivo con el
# mismo nombre, los visitantes recurrentes pueden tardar hasta una semana en ver el nuevo.
/gallery/*
  Cache-Control: public, max-age=604800
/gallery-thumbs/*
  Cache-Control: public, max-age=604800
/catalog/*
  Cache-Control: public, max-age=604800
/videos/*
  Cache-Control: public, max-age=604800
/logo/*
  Cache-Control: public, max-age=604800
